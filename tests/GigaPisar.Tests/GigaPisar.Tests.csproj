<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the microphone capture and the model cache. They compile src/App/Recorder.cs and
       src/App/IdleCache.cs themselves rather than the WPF app, so they run on Windows, Linux or macOS
       and never open a real microphone:
       dotnet test tests/GigaPisar.Tests -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- NAudio's WASAPI types are marked Windows-only; the tests stand in for everything that would reach the OS. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!-- The same version as src/GigaPisar.csproj. -->
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\App\Recorder.cs" Link="App\Recorder.cs" />
    <Compile Include="..\..\src\App\IdleCache.cs" Link="App\IdleCache.cs" />
  </ItemGroup>

</Project>
