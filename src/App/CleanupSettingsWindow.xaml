<Window x:Class="GigaPisar.App.CleanupSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" MinWidth="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="Intro" Margin="0,6,0,16" TextWrapping="Wrap" Opacity="0.8"/>

            <TextBlock x:Name="ProviderLabel" FontWeight="SemiBold"/>
            <ComboBox x:Name="ProviderBox" Margin="0,5,0,14" SelectionChanged="Provider_Changed"/>

            <TextBlock x:Name="KeyLabel" FontWeight="SemiBold"/>
            <PasswordBox x:Name="KeyBox" Margin="0,5,0,0" Padding="7,5" PasswordChanged="Key_Changed"/>
            <TextBlock Margin="0,4,0,14" TextWrapping="Wrap" Opacity="0.7">
                <Run x:Name="KeyHint"/>
                <Hyperlink x:Name="KeysLink" Click="KeysLink_Click"><Run x:Name="KeysLinkText"/></Hyperlink>
            </TextBlock>

            <StackPanel x:Name="UrlPanel">
                <TextBlock x:Name="UrlLabel" FontWeight="SemiBold"/>
                <TextBox x:Name="UrlBox" Margin="0,5,0,0" Padding="7,5"/>
                <TextBlock x:Name="UrlHint" Margin="0,4,0,14" TextWrapping="Wrap" Opacity="0.7"/>
            </StackPanel>

            <TextBlock x:Name="ModelLabel" FontWeight="SemiBold"/>
            <DockPanel Margin="0,5,0,0">
                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Padding="10,5" Margin="8,0,0,0" Click="Refresh_Click"/>
                <ComboBox x:Name="ModelBox" IsEditable="True" Padding="5,4"/>
            </DockPanel>
            <TextBlock x:Name="Status" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.75"/>

            <Expander x:Name="PromptExpander" Margin="0,14,0,0">
                <TextBox x:Name="PromptBox" Margin="0,6,0,0" Padding="7" Height="130"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
            </Expander>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" MinWidth="90" Padding="12,5" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="SaveButton" MinWidth="90" Padding="12,5" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
