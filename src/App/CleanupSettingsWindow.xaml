<Window x:Class="GigaPisar.App.CleanupSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="630" Height="680" MinWidth="460" MinHeight="450"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,22,0">
                <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="Intro" Margin="0,6,0,14" TextWrapping="Wrap" Opacity="0.8"/>
                <CheckBox x:Name="EnabledBox" Margin="0,0,0,14"/>
                <TextBlock x:Name="UrlLabel" FontWeight="SemiBold"/>
                <TextBox x:Name="UrlBox" Margin="0,5,0,0" Padding="7,5"/>
                <TextBlock x:Name="UrlHint" Margin="0,4,0,14" TextWrapping="Wrap" Opacity="0.7"/>
                <TextBlock x:Name="KeyLabel" FontWeight="SemiBold"/>
                <PasswordBox x:Name="KeyBox" Margin="0,5,0,0" Padding="7,5"/>
                <TextBlock x:Name="KeyHint" Margin="0,4,0,14" TextWrapping="Wrap" Opacity="0.7"/>
                <TextBlock x:Name="ModelLabel" FontWeight="SemiBold"/>
                <DockPanel Margin="0,5,0,14">
                    <Button x:Name="RefreshButton" DockPanel.Dock="Right" Padding="10,5" Margin="8,0,0,0" Click="Refresh_Click"/>
                    <ComboBox x:Name="ModelBox" IsEditable="True" Padding="5,4"/>
                </DockPanel>
                <TextBlock x:Name="PromptLabel" FontWeight="SemiBold"/>
                <TextBox x:Name="PromptBox" Margin="0,5,0,0" Padding="7" Height="115"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" MinWidth="90" Padding="12,5" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="SaveButton" MinWidth="90" Padding="12,5" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
