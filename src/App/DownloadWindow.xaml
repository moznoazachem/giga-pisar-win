<Window x:Class="GigaPisar.App.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Гига Писарь" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="Intro" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.8"/>
        <ProgressBar x:Name="Bar" Margin="0,18,0,0" Height="6" Minimum="0" Maximum="100"/>
        <TextBlock x:Name="Status" Margin="0,8,0,0" Opacity="0.8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="RetryButton" MinWidth="100" Margin="0,0,8,0" Visibility="Collapsed" Click="Retry_Click"/>
            <Button x:Name="CancelButton" MinWidth="100" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
