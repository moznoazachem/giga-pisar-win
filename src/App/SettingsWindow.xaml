<Window x:Class="GigaPisar.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:GigaPisar.App"
        Width="760" Height="500" MinWidth="640" MinHeight="420"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="NavItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sections, as in Windows 11 Settings -->
        <ListBox x:Name="Nav" Margin="10,14,6,14" BorderThickness="0" Background="Transparent"
                 SelectionChanged="Nav_Changed" ItemContainerStyle="{StaticResource NavItem}">
            <ListBoxItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE720;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="NavDictation" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEA80;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="NavBrain" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="NavAbout" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>
        </ListBox>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="16,18,28,20">

                <!-- Dictation -->
                <StackPanel x:Name="DictationPage">
                    <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="Intro" Margin="0,4,0,0" Opacity="0.75" TextWrapping="Wrap"/>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="HotkeyLabel" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="HotkeyBox" MinWidth="230" HorizontalAlignment="Left" SelectionChanged="Hotkey_Changed"/>
                        <TextBlock x:Name="InsertLabel" Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="InsertBox" Margin="0,10,0,0" MinWidth="230" HorizontalAlignment="Left" SelectionChanged="Insert_Changed"/>
                        <TextBlock x:Name="LanguageLabel" Grid.Row="2" Margin="0,10,0,0" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="LanguageBox" Margin="0,10,0,0" MinWidth="230" HorizontalAlignment="Left" SelectionChanged="Language_Changed"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <CheckBox x:Name="OverlayBox" VerticalAlignment="Center" Click="Overlay_Click"/>
                        <Button x:Name="UnpinButton" Margin="12,0,0,0" Padding="10,2" FontSize="12" Click="Unpin_Click"/>
                    </StackPanel>
                    <CheckBox x:Name="AutostartBox" Margin="0,10,0,0" Click="Autostart_Click"/>
                    <CheckBox x:Name="UpdatesBox" Margin="0,10,0,0" Click="Updates_Click"/>
                    <CheckBox x:Name="KeepBox" Margin="0,10,0,0" Click="Keep_Click"/>
                </StackPanel>

                <!-- Brain -->
                <StackPanel x:Name="BrainPage" Visibility="Collapsed">
                    <TextBlock x:Name="CleanupHeading" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CleanupHint" Margin="0,4,0,14" Opacity="0.75" TextWrapping="Wrap"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="BrainLabel" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="BrainBox" SelectionChanged="Brain_Changed"/>
                    </Grid>
                    <TextBlock x:Name="BrainStatus" Margin="110,6,0,0" FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
                    <app:BrainServerPanel x:Name="ServerPanel" Margin="0,10,0,0"/>
                    <Button x:Name="DeleteBrainButton" Margin="110,8,0,0" HorizontalAlignment="Left" Padding="10,3" Click="DeleteBrain_Click"/>
                    <CheckBox x:Name="EveryTakeBox" Margin="0,16,0,0" Click="EveryTake_Click"/>
                    <TextBlock x:Name="EveryTakeHint" Margin="28,2,0,0" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                    <Expander x:Name="PromptExpander" Margin="0,10,0,0">
                        <TextBox x:Name="PromptBox" Margin="0,6,0,0" Padding="7" Height="120" LostFocus="Prompt_LostFocus"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                    </Expander>
                </StackPanel>

                <!-- About -->
                <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                    <TextBlock x:Name="AboutHeading" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="About" Margin="0,8,0,0" Opacity="0.85" TextWrapping="Wrap"/>
                    <TextBlock x:Name="MicLine" Margin="0,8,0,0" Opacity="0.85" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ModelPath" Margin="0,8,0,0" FontSize="12" Opacity="0.65" TextWrapping="Wrap"/>
                    <TextBlock Margin="0,14,0,0">
                        <Hyperlink NavigateUri="https://gigapisar.github.io" RequestNavigate="Link_Click">gigapisar.github.io</Hyperlink>
                        <Run Text="  ·  "/>
                        <Hyperlink NavigateUri="https://github.com/moznoazachem/giga-pisar-win" RequestNavigate="Link_Click"><Run x:Name="CodeLink"/></Hyperlink>
                        <Run Text="  ·  "/>
                        <Hyperlink NavigateUri="https://github.com/salute-developers/GigaAM" RequestNavigate="Link_Click"><Run x:Name="ModelLink"/></Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0">
                        <Hyperlink Click="Log_Click"><Run x:Name="LogLink"/></Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
