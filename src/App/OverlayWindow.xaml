<Window x:Class="GigaPisar.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" SizeToContent="Manual" Width="120" Height="58">
    <Border x:Name="Pill" CornerRadius="15" Height="30" Width="92" Margin="14"
            HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="SizeAll"
            Background="#F5FFFFFF" BorderBrush="#1F000000" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="1" Direction="270" Opacity="0.20" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="Caption" Visibility="Collapsed" Padding="0,0,10,0" VerticalAlignment="Center"
                           FontSize="12.5" FontFamily="Segoe UI Variable Text, Segoe UI" TextWrapping="NoWrap"/>
                <!-- A solid lock, as SF Symbols lock.fill on macOS: shackle and body. -->
                <Canvas x:Name="LockIcon" Visibility="Collapsed" Width="10" Height="13" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Path Data="M2.6,6 V4 A2.4,2.4 0 0 1 7.4,4 V6" Stroke="#FF0A84FF" StrokeThickness="1.7"/>
                    <Rectangle Canvas.Top="5.5" Width="10" Height="7.5" RadiusX="1.6" RadiusY="1.6" Fill="#FF0A84FF"/>
                </Canvas>
                <StackPanel x:Name="Bars" Orientation="Horizontal" Height="22" VerticalAlignment="Center"/>
                <TextBlock x:Name="Elapsed" Visibility="Collapsed" Margin="8,0,0,0" VerticalAlignment="Center"
                           FontSize="12" FontFamily="Segoe UI Variable Text, Segoe UI" Opacity="0.6"/>
            </StackPanel>
            <TextBlock x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                       Foreground="#D9000000" FontSize="12.5" FontFamily="Segoe UI Variable Text, Segoe UI"/>
        </Grid>
    </Border>
</Window>
