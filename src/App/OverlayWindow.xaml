<Window x:Class="GigaPisar.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" SizeToContent="Manual" Width="120" Height="58">
    <Border x:Name="Pill" CornerRadius="15" Height="30" Width="92" Margin="14"
            HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="SizeAll"
            Background="#F5FFFFFF" BorderBrush="#1F000000" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="1" Direction="270" Opacity="0.20" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <StackPanel x:Name="Bars" Orientation="Horizontal" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                       Foreground="#D9000000" FontSize="12.5" FontFamily="Segoe UI Variable Text, Segoe UI"/>
        </Grid>
    </Border>
</Window>
