<Window x:Class="GigaPisar.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold"/>
        <!-- a long list scrolls inside, the buttons stay in place -->
        <ScrollViewer Margin="0,8,0,0" MaxHeight="200" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="Notes" TextWrapping="Wrap" Opacity="0.85"/>
        </ScrollViewer>
        <ProgressBar x:Name="Bar" Margin="0,18,0,0" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed"/>
        <TextBlock x:Name="Status" Margin="0,8,0,0" Opacity="0.8" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="HideButton" MinWidth="100" Margin="0,0,8,0" Visibility="Collapsed" Click="Hide_Click"/>
            <Button x:Name="LaterButton" MinWidth="100" Margin="0,0,8,0" Click="Later_Click"/>
            <Button x:Name="UpdateButton" MinWidth="120" IsDefault="True" Click="Update_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
