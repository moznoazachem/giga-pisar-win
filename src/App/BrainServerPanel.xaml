<UserControl x:Class="GigaPisar.App.BrainServerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="ProviderLabel" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="ProviderBox" SelectionChanged="Provider_Changed"/>

            <TextBlock Grid.Row="1" x:Name="KeyLabel" Margin="0,10,0,0" VerticalAlignment="Center"/>
            <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="KeyBox" Margin="0,10,0,0" Padding="7,5" PasswordChanged="Key_Changed"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,3,0,0" FontSize="12">
                <Hyperlink x:Name="KeysLink" Click="KeysLink_Click"><Run x:Name="KeysLinkText"/></Hyperlink>
            </TextBlock>

            <TextBlock Grid.Row="3" x:Name="UrlLabel" Margin="0,10,0,0" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="UrlBox" Margin="0,10,0,0" Padding="7,5" LostFocus="Url_LostFocus"/>

            <TextBlock Grid.Row="4" x:Name="ModelLabel" Margin="0,10,0,0" VerticalAlignment="Center"/>
            <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,10,0,0">
                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Padding="10,4" Margin="8,0,0,0" Click="Refresh_Click"/>
                <ComboBox x:Name="ModelBox" IsEditable="True" Padding="5,4" LostFocus="Model_LostFocus" SelectionChanged="Model_Changed"/>
            </DockPanel>
        </Grid>
        <TextBlock x:Name="Status" Margin="110,6,0,0" TextWrapping="Wrap" FontSize="12" Opacity="0.75"/>
    </StackPanel>
</UserControl>
